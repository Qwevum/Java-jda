# Copy this file to .env and fill in your own values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
#TOKEN=your-bot-token

# Prefix for text commands (defaults to ! if left out)
#PREFIX=!

# Your Discord user ID (enables the !shutdown command for you only)
#OWNER_ID=your-discord-user-id

# Optional: webhook used by the !webhook command
# Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
#WEBHOOK_URL=

# Optional: enables "!play sp: <search>". Spotify links work without this.
# Create an app at https://developer.spotify.com/dashboard and copy its client ID and secret.
#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=

# Optional: only needed if YouTube blocks the bot ("Sign in to confirm you're not a bot"), which
# mostly happens on hosting providers' servers. Use a spare Google account, not your main one:
# YouTube may limit or ban accounts used by bots.
# 1. Set YOUTUBE_OAUTH=new and start the bot. The console shows a code to enter at https://www.google.com/device
# 2. Sign in with the spare account. The console then prints a refresh token.
# 3. Replace "new" with that refresh token so the bot stays signed in after restarts.
#YOUTUBE_OAUTH=
